import ast
import matplotlib.pyplot as plt
import matplotlib.tri as mtri
import numpy as np


def load_list(filename):
    with open(filename, "r", encoding="utf-8") as f:
        return ast.literal_eval(f.read().strip())


def plot_torsion_results():
    coords = np.array(load_list("nodal coordinates.txt"), dtype=float)
    conn = load_list("connectivity array.txt")
    phi = np.array(load_list("nodal_phi.txt"), dtype=float)
    stresses = np.array(load_list("element_stresses.txt"), dtype=float)

    # Convert Q4 elements into two triangles for matplotlib triangulation plotting
    tris = []
    tri_stresses = []
    centroids = []
    for elem, s in zip(conn, stresses):
        centroids.append(coords[elem].mean(axis=0))
        if len(elem) == 3:
            tris.append(elem)
            tri_stresses.append(s)
        elif len(elem) == 4:
            tris.append([elem[0], elem[1], elem[2]])
            tris.append([elem[0], elem[2], elem[3]])
            tri_stresses.append(s)
            tri_stresses.append(s)

    centroids = np.array(centroids)
    tri_stresses = np.array(tri_stresses)
    triang = mtri.Triangulation(coords[:, 0], coords[:, 1], np.array(tris))

    fig, axes = plt.subplots(1, 3, figsize=(16, 4.8))

    # 1. Contour plot of stress function phi
    c1 = axes[0].tricontourf(triang, phi, levels=20, cmap="viridis")
    axes[0].triplot(triang, color="k", lw=0.3, alpha=0.4)
    fig.colorbar(c1, ax=axes[0], label=r"$\phi$ (N/m)")
    axes[0].set_title(r"Stress Function $\phi$")
    axes[0].set_aspect("equal")

    # 2. Element-wise von Mises effective stress contour
    c2 = axes[1].tripcolor(
        triang, facecolors=tri_stresses[:, 2], shading="flat", cmap="plasma"
    )
    fig.colorbar(c2, ax=axes[1], label=r"$\sigma_{\mathrm{vm}}$ (Pa)")
    axes[1].set_title(r"von Mises Effective Stress $\sigma_{\mathrm{vm}}$")
    axes[1].set_aspect("equal")

    # 3. Vector plot of shear stress (tau_xz, tau_yz) at element centroids
    axes[2].triplot(triang, color="lightgray", lw=0.4)
    axes[2].quiver(
        centroids[:, 0],
        centroids[:, 1],
        stresses[:, 0],
        stresses[:, 1],
        color="crimson",
    )
    axes[2].set_title(r"Shear Stress Vectors $(\tau_{xz}, \tau_{yz})$")
    axes[2].set_aspect("equal")

    for ax in axes:
        ax.set_xlabel("x (m)")
        ax.set_ylabel("y (m)")

    plt.tight_layout()
    plt.savefig("torsion_plots.png", dpi=300)
    plt.show()


if __name__ == "__main__":
    plot_torsion_results()
