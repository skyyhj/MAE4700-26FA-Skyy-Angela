                                                                        #NEW function from guide
def element_geometry(x1, x2):
    """
    Get element lengths and angles
    """
    delta = x2 - x1
    L = np.linalg.norm(delta)

    if L <= 0.0:
        raise ValueError"Truss element has zero length")
        
    c = delta[0] / L
    s = delta[1] / L
    return L, c, s

